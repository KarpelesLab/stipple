<?xml version="1.0" encoding="utf-8"?>
<!-- Another app's side of the clipboard, for examples/androiddemo/test-services.sh:
     a receiver that puts a text on the clipboard (writing is allowed from the
     background), and an activity that reads it once it has focus (Android 10
     and later only let the focused app read) and logs it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.stipple.clip">
  <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34"/>
  <application android:label="Stipple clipboard probe">
    <receiver android:name=".Set" android:exported="true">
      <intent-filter>
        <action android:name="org.stipple.clip.SET"/>
      </intent-filter>
    </receiver>
    <activity android:name=".Read" android:exported="true" android:excludeFromRecents="true"
        android:noHistory="true"/>
  </application>
</manifest>
