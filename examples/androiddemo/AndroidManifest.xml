<?xml version="1.0" encoding="utf-8"?>
<!-- The APK manifest for androiddemo: a NativeActivity that loads
     libstipple_android.so. configChanges keeps the activity (and the app's
     state) across rotation, resizing and dark-mode switches, which Stipple
     handles itself. enableOnBackInvokedCallback opts into predictive back
     (Android 13 and later): Back goes to the app's OnBackInvokedCallback, which
     Stipple registers only while the app would go back. versionName and
     versionCode are what platform::app_info reports (test-on-device.sh
     checks them). The APK carries a classes.dex with Stipple's Alarm receiver,
     Tapped activity and Files provider (build-apk.sh writes it), so scheduled notifications
     show while the process is gone, and are set again after a reboot, and a
     tap on one is reported while the activity runs too (and the Link
     activity reports the stipple-demo:// URLs that open it); the exact-alarm
     permissions let them show on time. See docs/platforms/android.md for
     packaging. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.karpeleslab.stipple"
    android:versionCode="7" android:versionName="1.2.3">
  <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34"/>
  <!-- platform::notify, on Android 13 and later. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <!-- platform::schedule_notification: exact alarms (granted by default on
       Android 12 with the first, on 13 and later with the second), and the
       alarms set again after a reboot. -->
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32"/>
  <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
  <!-- platform::network and App::on_network: the default network's
       callback. -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
  <application android:label="Stipple" android:hasCode="true" android:debuggable="true"
      android:enableOnBackInvokedCallback="true"
      android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">
    <activity android:name="android.app.NativeActivity" android:exported="true"
        android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|locale|layoutDirection">
      <meta-data android:name="android.app.lib_name" android:value="stipple_android"/>
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
    <receiver android:name="org.stipple.android.Alarm" android:exported="false">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED"/>
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
      </intent-filter>
    </receiver>
    <activity android:name="org.stipple.android.Tapped" android:exported="false"
        android:taskAffinity="" android:excludeFromRecents="true" android:noHistory="true"
        android:theme="@android:style/Theme.NoDisplay"/>
    <!-- URLs of the stipple-demo scheme (App::on_open_url): the same kind of
         windowless activity hands the URL to the app and brings it forward,
         as the NativeActivity doesn't pass onNewIntent on. -->
    <activity android:name="org.stipple.android.Link" android:exported="true"
        android:taskAffinity="" android:excludeFromRecents="true" android:noHistory="true"
        android:theme="@android:style/Theme.NoDisplay">
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="stipple-demo"/>
      </intent-filter>
    </activity>
    <!-- Files dragged out of the app (a long press on a drag source) go
         to other apps as this provider's content: URIs, granted per drag. -->
    <provider android:name="org.stipple.android.Files"
        android:authorities="com.karpeleslab.stipple.stipple.files"
        android:exported="false" android:grantUriPermissions="true"/>
  </application>
</manifest>
