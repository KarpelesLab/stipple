<?xml version="1.0" encoding="utf-8"?>
<!-- The APK manifest for cameraview: a NativeActivity that loads
     libstipple_android.so (built from the cameraview_android example), with
     the camera permission it asks for at run time (platform::permission).
     Build it with
       STIPPLE_APK_EXAMPLE=cameraview_android \
       STIPPLE_APK_MANIFEST=examples/cameraview/AndroidManifest.xml \
       bash examples/androiddemo/build-apk.sh x86_64 cameraview.apk
     The camera is Camera2 through the NDK (Android 7 and later). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.karpeleslab.stipple.camera"
    android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34"/>
  <uses-permission android:name="android.permission.CAMERA"/>
  <uses-feature android:name="android.hardware.camera.any" android:required="false"/>
  <application android:label="Stipple Camera" android:hasCode="true" android:debuggable="true"
      android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
    <activity android:name="android.app.NativeActivity" android:exported="true"
        android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|locale|layoutDirection">
      <meta-data android:name="android.app.lib_name" android:value="stipple_android"/>
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
